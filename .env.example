# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider: set at least one key. If both keys are present, Anthropic is
#     preferred — set LLM_PROVIDER to override. ---

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model slug; default is NVIDIA Nemotron 3 Ultra (free)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Anthropic (https://platform.claude.com/settings/keys) — optional alternative
# ANTHROPIC_API_KEY=sk-ant-...

# Force provider selection: openrouter | anthropic (optional; auto-detected from keys otherwise)
# LLM_PROVIDER=openrouter

# --- Email delivery ---
# Provider is auto-detected: if RESEND_API_KEY is set -> Resend, else -> Gmail.
# Force one with EMAIL_PROVIDER=resend|gmail.
# EMAIL_PROVIDER=resend

# Option A: Gmail SMTP (fine for a few recipients; no domain needed)
GMAIL_ADDRESS=you@gmail.com
# Gmail App Password (myaccount.google.com -> Security -> 2-Step Verification -> App passwords)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Option B: Resend (for a real list on your own verified domain)
# RESEND_API_KEY=re_xxxxxxxx
# From address on your verified domain (display name optional):
# MAIL_FROM=Your AI Digest <news@yourdomain.com>

# Recipients: comma-separated, one email each will be sent per address
DIGEST_TO=you@gmail.com

# Shared (optional, improves inbox placement):
# Where replies go (defaults to none)
# MAIL_REPLY_TO=you@yourdomain.com
# Unsubscribe target — an https:// URL (enables true one-click) or a mailto:
# MAIL_UNSUBSCRIBE=mailto:unsubscribe@yourdomain.com?subject=unsubscribe
